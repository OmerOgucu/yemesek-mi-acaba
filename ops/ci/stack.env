# CI disposable stack only. These values are sentinels, not a production account.
NODE_ENV=production
PORT=3001
TRUST_PROXY_HOPS=1
JWT_ACCESS_SECRET=ci-jwt-access-secret-32-characters-min
POSTGRES_USER=yemesek
POSTGRES_PASSWORD=ci-postgres-password
POSTGRES_DB=yemesek
DATABASE_URL=postgresql://yemesek:ci-postgres-password@postgres:5432/yemesek
APP_PUBLIC_URL=https://web.yemesek.test:8443
API_URL=https://api.yemesek.test:8444
NEXT_PUBLIC_API_URL=https://api.yemesek.test:8444
EXPO_PUBLIC_API_URL=https://api.yemesek.test:8444
CORS_ORIGINS=https://web.yemesek.test:8443
BREVO_API_KEY=ci-brevo-key-not-a-real-account
BREVO_API_URL=http://mail:8025/v3/smtp/email
BREVO_SENDER_EMAIL=noreply@yemesek.test
BREVO_SENDER_NAME=Yemesek
EMAIL_VERIFICATION_TTL_MINUTES=30
STORAGE_DRIVER=s3
S3_BUCKET=yemesek-evidence
S3_ACCESS_KEY_ID=ciaccesskey
S3_SECRET_ACCESS_KEY=cisecretvalue123456
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
PROJECT_CONTROLLER_NAME=CI Denetleyici
PROJECT_CONTACT_EMAIL=privacy@yemesek.test
PROJECT_CONTACT_ADDRESS=CI Adres Satiri
INITIAL_ADMIN_EMAIL=admin@yemesek.test
INITIAL_ADMIN_SETUP_SECRET=ci-admin-setup-secret
INITIAL_ALLOWED_CITIES=istanbul
DEPLOY_PROFILE=localhost
API_BIND_PORT=3001
WEB_BIND_PORT=3000
API_HOST=api.yemesek.test
WEB_HOST=web.yemesek.test
TRAEFIK_ENABLE=false
BACKUP_PASSPHRASE=ci-backup-passphrase
BACKUP_S3_BUCKET=yemesek-backups
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_ACCESS_KEY_ID=ciaccesskey
BACKUP_S3_SECRET_ACCESS_KEY=cisecretvalue123456
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=yemesek
BACKUP_MAX_AGE_HOURS=26
RESTORE_DATABASE_URL=postgresql://restore_only:ci-restore-password@postgres:5432/yemesek_disposable
JOB_TICK_MS=1000
JOB_LEASE_MS=60000
