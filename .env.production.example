# Tek production dosyası. Değerleri doldur. init-env.sh yalnız boş/FILL_ME sırları üretir ve ekrana basmaz.
# NEXT_PUBLIC_* ve EXPO_PUBLIC_* istemciye gider. Sır koyma.
# API_INTERNAL_URL ve DATABASE_URL iç adresleri mobil/web bundle'ına kopyalama.

NODE_ENV=production
PORT=3001
TRUST_PROXY_HOPS=1

JWT_ACCESS_SECRET=FILL_ME
POSTGRES_USER=yemesek
POSTGRES_PASSWORD=FILL_ME
POSTGRES_DB=yemesek
DATABASE_URL=postgresql://yemesek:FILL_ME@postgres:5432/yemesek

APP_PUBLIC_URL=https://FILL_ME
API_URL=https://FILL_ME
NEXT_PUBLIC_API_URL=https://FILL_ME
EXPO_PUBLIC_API_URL=https://FILL_ME
API_INTERNAL_URL=
CORS_ORIGINS=https://FILL_ME

BREVO_API_KEY=FILL_ME
BREVO_API_URL=
BREVO_SENDER_EMAIL=FILL_ME
BREVO_SENDER_NAME=Yemesek mi acaba
EMAIL_VERIFICATION_TTL_MINUTES=30

STORAGE_DRIVER=s3
S3_BUCKET=FILL_ME
S3_ACCESS_KEY_ID=FILL_ME
S3_SECRET_ACCESS_KEY=FILL_ME
S3_ENDPOINT=https://FILL_ME
S3_REGION=auto
S3_FORCE_PATH_STYLE=false

PROJECT_CONTROLLER_NAME=FILL_ME
PROJECT_CONTACT_EMAIL=FILL_ME
PROJECT_CONTACT_ADDRESS=FILL_ME

INITIAL_ADMIN_EMAIL=FILL_ME
INITIAL_ADMIN_SETUP_SECRET=FILL_ME
INITIAL_ALLOWED_CITIES=ankara,istanbul

DEPLOY_PROFILE=edge
EDGE_NETWORK=FILL_ME
API_HOST=FILL_ME
WEB_HOST=FILL_ME
TRAEFIK_ENABLE=false
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
API_BIND_PORT=3001
WEB_BIND_PORT=3000
RELEASE_TAG=local
JOB_TICK_MS=30000

BACKUP_PASSPHRASE=FILL_ME
BACKUP_S3_BUCKET=FILL_ME
BACKUP_S3_ENDPOINT=https://FILL_ME
BACKUP_S3_ACCESS_KEY_ID=FILL_ME
BACKUP_S3_SECRET_ACCESS_KEY=FILL_ME
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=yemesek
BACKUP_MAX_AGE_HOURS=26
ALERT_WEBHOOK_URL=
BACKUP_FILE=
RESTORE_DATABASE_URL=

ANDROID_PACKAGE=
ANDROID_SHA256_CERT_FINGERPRINTS=
APPLE_TEAM_ID=
IOS_BUNDLE_ID=
