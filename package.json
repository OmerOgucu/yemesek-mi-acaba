{
  "name": "yemesek-mi-acaba",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @yemesek/api --filter @yemesek/web dev",
    "dev:api": "pnpm --filter @yemesek/api dev",
    "dev:web": "pnpm --filter @yemesek/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @yemesek/api db:migrate",
    "db:seed": "pnpm --filter @yemesek/api db:seed"
  }
}
