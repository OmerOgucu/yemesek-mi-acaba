{
  "name": "yemesek-mi-acaba",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@types/react": "19.1.13",
      "@types/react-dom": "19.1.9",
      "decode-uri-component": "0.5.0",
      "postcss": "8.5.23",
      "query-string": "7.1.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-w5hq-g745-h8pq"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @yemesek/api --filter @yemesek/web dev",
    "dev:api": "pnpm --filter @yemesek/api dev",
    "dev:web": "pnpm --filter @yemesek/web dev",
    "dev:mobile": "pnpm --filter @yemesek/mobile dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "mkdir -p ops/state && rm -f ops/state/node-tests.ndjson && (pnpm -r --if-present test && node --test --test-reporter=spec --test-reporter=./ops/verify/test-reporter.mjs --test-reporter-destination=stdout --test-reporter-destination=ops/state/node-tests.ndjson ops/lib/*.test.mjs ops/verify/*.test.mjs); ec=$?; node ops/verify/collect-evidence.mjs; exit $ec",
    "audit:deps": "pnpm audit --prod",
    "db:migrate": "pnpm --filter @yemesek/database db:migrate",
    "db:seed": "pnpm --filter @yemesek/database db:seed"
  }
}
