generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  passwordHash        String
  displayName         String
  role                UserRole            @default(USER)
  emailVerifiedAt     DateTime?
  disabledAt          DateTime?
  kvkkAcceptedAt      DateTime
  termsAcceptedAt     DateTime
  marketingAcceptedAt DateTime?
  createdAt           DateTime            @default(now())
  reports             Report[]
  votes               Vote[]
  restaurants         Restaurant[]
  refreshTokens       RefreshToken[]
  emailVerifications  EmailVerification[]
  badges              UserBadge[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model City {
  id          String       @id @default(cuid())
  name        String
  key         String       @unique
  createdAt   DateTime     @default(now())
  districts   District[]
  restaurants Restaurant[]
}

model District {
  id          String       @id @default(cuid())
  cityId      String
  city        City         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name        String
  key         String
  createdAt   DateTime     @default(now())
  restaurants Restaurant[]

  @@unique([cityId, key])
  @@index([cityId])
}

model Restaurant {
  id            String    @id @default(cuid())
  name          String
  city          String
  cityKey       String
  cityId        String?
  cityPlace     City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  district      String?
  districtId    String?
  districtPlace District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  addressHint   String?
  cuisine       String?
  hidden        Boolean   @default(false)
  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  reports       Report[]

  @@index([cityKey])
  @@index([cityId])
  @@index([districtId])
  @@index([createdById])
}

model Report {
  id           String         @id @default(cuid())
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  authorId     String
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category     ReportCategory
  severity     Int
  title              String
  body               String
  nickname           String         @default("anonim")
  photoUrls          Json
  receiptUrl         String
  evidenceVerified   Boolean            @default(false)
  moderationStatus   ModerationStatus   @default(PENDING)
  hidden             Boolean            @default(false)
  moderationNote     String?
  createdAt          DateTime           @default(now())
  votes        Vote[]

  @@index([restaurantId, createdAt])
  @@index([authorId])
}

model Vote {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reportId, userId])
  @@index([reportId])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([codeHash])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  key       String   @id
  subject   String
  htmlBody  String
  textBody  String
  updatedAt DateTime @updatedAt
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String
  metric      BadgeMetric
  threshold   Int
  sortOrder   Int         @default(0)
  enabled     Boolean     @default(true)
  awards      UserBadge[]
}

model UserBadge {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge            @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  source    BadgeAwardSource @default(AUTO)
  awardedAt DateTime         @default(now())
  revokedAt DateTime?

  @@unique([userId, badgeId])
  @@index([userId])
}

enum UserRole {
  USER
  ADMIN
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BadgeMetric {
  REPORTS_FILED
  HELPFUL_VOTES_RECEIVED
  VENUES_ADDED
  HELPFUL_VOTES_GIVEN
}

enum BadgeAwardSource {
  AUTO
  MANUAL
}

enum ReportCategory {
  HYGIENE
  FOOD_POISONING
  SCAM_PRICING
  RUDE_SERVICE
  WRONG_OR_COLD
  FALSE_ADS
}
