{
  "name": "@yemesek/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "postinstall": "DATABASE_URL=postgresql://yemesek:yemesek@127.0.0.1:5432/yemesek_dev prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "sh scripts/with-db.sh prisma migrate deploy",
    "db:bootstrap": "sh scripts/with-db.sh tsx src/bootstrap-cli.ts",
    "db:seed": "sh scripts/with-db.sh prisma db seed",
    "db:dev-migrate": "sh scripts/with-db.sh prisma migrate dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@prisma/client": "^6.16.2",
    "@yemesek/config": "workspace:*",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
