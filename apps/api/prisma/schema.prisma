generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String
  displayName         String
  kvkkAcceptedAt      DateTime
  termsAcceptedAt     DateTime
  marketingAcceptedAt DateTime?
  createdAt           DateTime       @default(now())
  reports             Report[]
  votes               Vote[]
  refreshTokens       RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  city        String
  district    String?
  addressHint String?
  cuisine     String?
  createdAt   DateTime @default(now())
  reports     Report[]

  @@index([city])
}

model Report {
  id           String         @id @default(cuid())
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  authorId     String
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category     ReportCategory
  severity     Int
  title        String
  body         String
  nickname     String         @default("anonim")
  createdAt    DateTime       @default(now())
  votes        Vote[]

  @@index([restaurantId, createdAt])
  @@index([authorId])
}

model Vote {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reportId, userId])
  @@index([reportId])
}

enum ReportCategory {
  HYGIENE
  FOOD_POISONING
  SCAM_PRICING
  RUDE_SERVICE
  WRONG_OR_COLD
  FALSE_ADS
}
