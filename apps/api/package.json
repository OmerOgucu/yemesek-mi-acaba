{
  "name": "@yemesek/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "DATABASE_URL=file:./dev.db prisma generate",
    "dev": "DATABASE_URL=file:./dev.db prisma generate && sh scripts/with-db.sh tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "build": "DATABASE_URL=file:./dev.db prisma generate && tsc -p tsconfig.build.json",
    "start": "sh scripts/with-db.sh node dist/main.js",
    "typecheck": "DATABASE_URL=file:./dev.db prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "DATABASE_URL=file:./dev.db prisma generate && jest --runInBand",
    "db:migrate": "sh scripts/with-db.sh prisma migrate deploy",
    "db:seed": "sh scripts/with-db.sh prisma db seed",
    "db:dev-migrate": "sh scripts/with-db.sh prisma migrate dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@nestjs/testing": "^11.1.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "jest": "^29.7.0",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
