# Resolved from packages/database/prisma/schema.prisma. Dev scripts set an absolute path.
DATABASE_URL="file:./dev.db"
PORT=3001
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
# Production bu değeri ve "change-me"yi reddeder. En az 32 karakter, rastgele. Örnek üretme:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Leave unset so scripts use <repo>/uploads. Production should use object storage.
# UPLOADS_DIR=

# Mail. Leave BREVO_API_KEY empty in local dev: the code and link are logged.
# Never commit a real key.
BREVO_API_KEY=
BREVO_SENDER_EMAIL="noreply@yemesek.local"
BREVO_SENDER_NAME="Yemesek mi acaba"
# Yerel bağlantılar localhost’ta kalır. Yayındaki kök https olmalı; aksi halde süreç açılmaz.
APP_PUBLIC_URL="http://localhost:3000"
# Boşsa yalnızca localhost:3000 ve :8081 kabul edilir.
# Production zorunlu, aksi halde süreç açılmaz: https://yemesekmiacaba.com
# www kullanılıyorsa virgülle ekle. Gizli değildir.
CORS_ORIGINS=
EMAIL_VERIFICATION_TTL_MINUTES=30

# Captcha. none skips verification. turnstile or hcaptcha need a secret. Tests bypass this.
CAPTCHA_PROVIDER=none
TURNSTILE_SECRET=
HCAPTCHA_SECRET=

# Sentry. Empty means no reports are sent.
SENTRY_DSN=

# Storage. local is the default for this machine. Production should set s3 (R2 or S3).
# The process still boots on local and prints a warning. Do not put real keys in git.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Optional higher GET limit when this header matches. Leave empty to use the anonymous cap.
BULK_API_KEY=

# Expo push. Empty means send attempts are logged and not delivered.
EXPO_ACCESS_TOKEN=
