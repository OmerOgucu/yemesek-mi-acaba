# Resolved from packages/database/prisma/schema.prisma. Dev scripts set an absolute path.
DATABASE_URL="file:./dev.db"
PORT=3001
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
# Leave unset so scripts use <repo>/uploads. Production should use object storage.
# UPLOADS_DIR=

# Mail. Leave BREVO_API_KEY empty in local dev: the code and link are logged.
# Never commit a real key.
BREVO_API_KEY=
BREVO_SENDER_EMAIL="noreply@yemesek.local"
BREVO_SENDER_NAME="Yemesek mi acaba"
APP_PUBLIC_URL="http://localhost:3000"
EMAIL_VERIFICATION_TTL_MINUTES=30
