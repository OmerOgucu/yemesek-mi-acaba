# Telefonda localhost çalışmaz. Derlemeden önce bilgisayarın yerel IP’sini yaz.
# Android emülatör: http://10.0.2.2:3001
# iOS simülatör: http://localhost:3001
# Fiziksel cihaz: http://<yerel-ip>:3001
# Yayın derlemesi https olmalı. http ise prebuild cleartext açar; https derlemesi açmaz.
# Gizli değildir. Mağaza anahtarlarını buraya koyma.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
