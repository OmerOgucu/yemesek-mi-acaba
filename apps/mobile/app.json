{
  "expo": {
    "name": "Yemesek mi acaba?",
    "slug": "yemesek",
    "scheme": "yemesek",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Şikayete yemek, mekan ve fiş fotoğrafı eklemek için galeri izni gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "bundleIdentifier": "com.yemesek.app",
      "associatedDomains": ["applinks:yemesek.example"]
    },
    "android": {
      "package": "com.yemesek.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "yemesek.example", "pathPrefix": "/dogrula" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}
