{
  "expo": {
    "name": "Yemesek mi acaba?",
    "slug": "yemesek",
    "scheme": "yemesek",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Şikayete yemek, mekan ve fiş fotoğrafı eklemek için galeri izni gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "com.yemesek.app"
    },
    "ios": {
      "bundleIdentifier": "com.yemesek.app"
    }
  }
}
